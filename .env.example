# Semantica vector store
VECTOR_STORE_DEFAULT_BACKEND=qdrant
VECTOR_STORE_DIMENSION=768
VECTOR_STORE_QDRANT_URL=http://qdrant-mem0:6333
# Mem0 currently runs Qdrant without an API key. Set this if authentication is enabled.
VECTOR_STORE_QDRANT_API_KEY=

# Local Explorer binding. Platform traffic reaches the service on ob-net-back.
SEMANTICA_EXPLORER_BIND_HOST=127.0.0.1
SEMANTICA_EXPLORER_PORT=8001
